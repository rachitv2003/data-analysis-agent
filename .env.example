# Data Analysis Agent — environment variables
# Copy to .env and fill in your values

# ── Required ──────────────────────────────────────────────────────────────────
DATA_ANALYST_DATABASE_URL=sqlite:///data_analyst.db

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Set this to use real Gemini. Leave blank for stub mode (visible banner in UI).
DATA_ANALYST_GEMINI_API_KEY=

# Model name — do not change unless you know the exact model ID
DATA_ANALYST_LLM_MODEL=gemini-2.5-flash

# ── Agent tuning ──────────────────────────────────────────────────────────────
# Maximum ReAct loop iterations before giving up
DATA_ANALYST_MAX_ITERATIONS=10

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8001
DATA_ANALYST_LOG_LEVEL=INFO
