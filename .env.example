# Data Analysis Agent — environment variables
# Copy to .env and fill in your values

# ── Required ──────────────────────────────────────────────────────────────────
DATA_ANALYST_DATABASE_URL=sqlite:///data_analyst.db

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose a provider: gemini | openrouter | stub
# Leave blank to auto-detect: openrouter key present → openrouter; gemini key present → gemini; else stub
DATA_ANALYST_LLM_PROVIDER=

# Gemini API key (used when LLM_PROVIDER=gemini or auto-detected)
DATA_ANALYST_GEMINI_API_KEY=

# OpenRouter API key (used when LLM_PROVIDER=openrouter or auto-detected)
# Get one at https://openrouter.ai/keys
DATA_ANALYST_OPENROUTER_API_KEY=

# Model name — must be valid for the active provider
# Gemini examples:     gemini-2.5-flash, gemini-2.5-pro
# OpenRouter examples: google/gemini-2.5-flash, anthropic/claude-3-5-sonnet, openai/gpt-4o, z-ai/glm-5.2
DATA_ANALYST_LLM_MODEL=gemini-2.5-flash

# ── Agent tuning ──────────────────────────────────────────────────────────────
# Maximum ReAct loop iterations before force-finalizing
DATA_ANALYST_MAX_ITERATIONS=6

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8001
DATA_ANALYST_LOG_LEVEL=INFO
